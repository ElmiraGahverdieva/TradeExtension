# Dzengi API Credentials
DZENGI_API_KEY=your_api_key_here
DZENGI_SECRET_KEY=your_secret_key_here
DZENGI_ENV=demo

# Trading Settings
SYMBOLS=BTCUSDT,ETHUSDT,XRPUSDT
TIMEFRAME=15m
MIN_SIGNALS=3

# Indicator Parameters
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
EMA_FAST=9
EMA_SLOW=21
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
BB_PERIOD=20
BB_STD_DEV=2.0
VOLUME_PERIOD=20
VOLUME_MULTIPLIER=1.3

# Notifications
NOTIFICATION_MODE=desktop
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log
